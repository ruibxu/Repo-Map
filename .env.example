# Configure these variables in your shell before starting the backend.
REPOMAP_DATA_DIR=.repomap
REPOMAP_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
REPOMAP_EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
REPOMAP_CPU_THREADS=4
# Optional Chat Completions-compatible service. Leave unset for search-only mode.
REPOMAP_LLM_BASE_URL=
REPOMAP_LLM_MODEL=
REPOMAP_LLM_API_KEY=
